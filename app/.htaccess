# Keep real files and directories (assets, fonts, scripts) unchanged.
# Send client-side React routes such as /app/buy to the SPA entry point.
RewriteEngine On
RewriteBase /app/

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]
